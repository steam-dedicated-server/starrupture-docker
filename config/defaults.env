# Default configuration values for `star`.
# Override via config/server.env, an .env file, or container env vars.

# Install location for the dedicated server.
# Inside the Docker image: /mnt/steam is the persistent volume mount
# (upstream convention; matches existing K8s PVCs so volumes migrate
# cleanly between game-server images in this ecosystem).
INSTALL_DIR="${INSTALL_DIR:-/mnt/steam/starrupture}"

# Steam App ID for the Starrupture dedicated server.
# Unlike some games (Last Oasis, ARK) there is no separate runtime
# id — the installer and runtime share 3809400, so no steam_appid.txt
# fixup is required after install.
STEAM_APP_ID="${STEAM_APP_ID:-3809400}"

# Steam user: `anonymous` downloads without login (no 2FA needed).
# Starrupture's dedicated server depot is anonymously downloadable.
STEAM_USER="${STEAM_USER:-anonymous}"

# Server identity and network
SERVER_NAME="${SERVER_NAME:-starrupture-server}"
SERVER_PORT="${SERVER_PORT:-7777}"
SERVER_QUERY_PORT="${SERVER_QUERY_PORT:-27015}"
MULTIHOME="${MULTIHOME:-}"

# DSSettings.txt — file-based session config (recommended).
# When false, the in-game Server Manager UI is used instead, which
# requires the TCP game port to be reachable from the operator and
# has a published vulnerability advisory.
USE_DSSETTINGS="${USE_DSSETTINGS:-true}"
SESSION_NAME="${SESSION_NAME:-StarRuptureServer}"
SAVE_GAME_INTERVAL="${SAVE_GAME_INTERVAL:-300}"
START_NEW_GAME="${START_NEW_GAME:-false}"
LOAD_SAVED_GAME="${LOAD_SAVED_GAME:-true}"
SAVE_GAME_NAME="${SAVE_GAME_NAME:-AutoSave0.sav}"

# Wine configuration. The prefix lives on the persistent volume so
# the first-boot cost is paid once across container restarts.
WINEPREFIX="${WINEPREFIX:-/mnt/steam/.wine}"
WINEARCH="${WINEARCH:-win64}"
WINEDEBUG="${WINEDEBUG:--all}"

# Retry behavior for steamcmd downloads.
# DOWNLOAD_MAX_ATTEMPTS is the upstream/K8s-facing name; STAR_RETRY_MAX
# is the internal name used by star::retry. Honoring the former lets
# existing K8s manifests pass the value through unchanged.
STAR_RETRY_MAX="${STAR_RETRY_MAX:-${DOWNLOAD_MAX_ATTEMPTS:-5}}"
STAR_RETRY_DELAY="${STAR_RETRY_DELAY:-2}"

# Backup defaults
BACKUP_DIR="${BACKUP_DIR:-/mnt/steam/backups}"

# Healthcheck (used by docker/healthcheck.py)
HEALTHCHECK_HOST="${HEALTHCHECK_HOST:-127.0.0.1}"
HEALTHCHECK_TIMEOUT="${HEALTHCHECK_TIMEOUT:-3}"
