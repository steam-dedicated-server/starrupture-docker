# ============================================================
# Starrupture dedicated server — user configuration
# Copy to `server.env` (or supply via compose `environment:`)
# and fill in your values. Overrides defaults.env.
# ============================================================

# --- IDENTITY ---

# Server display name (shown in matchmaking / server browser).
SERVER_NAME="starrupture-server"

# Game UDP port (default: 7777). Must be reachable on the public IP.
SERVER_PORT="7777"

# Steam A2S query UDP port (default: 27015). Used by the in-game
# server browser and by this image's healthcheck.
SERVER_QUERY_PORT="27015"

# Bind the engine to a specific interface (rarely needed). Leave
# empty unless you have a multi-NIC host or need to bind to a
# specific virtual IP.
# MULTIHOME=""


# --- SESSION (USE_DSSETTINGS=true) ---

# Render DSSettings.txt from these variables before launch.
# Strongly recommended over `false` — the alternative requires the
# TCP game port to be reachable and has had reported vulnerabilities.
USE_DSSETTINGS="true"

# In-game session display name.
SESSION_NAME="StarRuptureServer"

# Autosave interval (seconds).
SAVE_GAME_INTERVAL="300"

# First-boot handshake — see README "First boot" section.
# After a save exists, flip to: START_NEW_GAME=false, LOAD_SAVED_GAME=true.
START_NEW_GAME="false"
LOAD_SAVED_GAME="true"
SAVE_GAME_NAME="AutoSave0.sav"


# --- PASSWORDS (OPTIONAL) ---

# Starrupture stores admin / player passwords as game-encrypted JSON
# files alongside the install (`Password.json`, `PlayerPassword.json`).
# This image does NOT call any third-party API to generate them — see
# README "Passwords" for the supported workflow (generate the encrypted
# blob with the official utility, then drop it onto the volume).


# --- ADVANCED ---

# Additional Unreal Engine CLI flags, appended verbatim to the
# launch command. Word-split is intentional.
# SERVER_OPTIONS="-NOSTEAM -nullrhi"

# Steam login. Starrupture's dedicated server is anonymously
# downloadable; switch only if `star install` reports a login failure.
# STEAM_USER="anonymous"

# Override the in-volume game install path.
# INSTALL_DIR="/mnt/steam/starrupture"

# Where backups land (on the persistent volume).
# BACKUP_DIR="/mnt/steam/backups"

# Wine prefix and arch (rarely overridden).
# WINEPREFIX="/mnt/steam/.wine"
# WINEARCH="win64"

# Logging verbosity (`info` or `debug`).
# STAR_LOG_LEVEL="info"
